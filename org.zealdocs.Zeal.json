{
    "id": "org.zealdocs.Zeal",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "base": "io.qt.qtwebengine.BaseApp",
    "base-version": "6.11",
    "command": "zeal",
    "rename-appdata-file": "org.zealdocs.zeal.appdata.xml",
    "rename-desktop-file": "org.zealdocs.zeal.desktop",
    "rename-icon": "zeal",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--talk-name=org.kde.StatusNotifierWatcher"
    ],
    "cleanup-commands": [
        "/app/cleanup-BaseApp.sh"
    ],
    "modules": [
        {
            "name": "zeal",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                "-DZEAL_FEATURE_UPDATE_CHECK=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/zealdocs/zeal.git",
                    "commit": "9661b3d84c9288df4561dfbed5c93ee14dea7bef",
                    "tag": "v0.9.2",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([\\d.]+)$"
                    }
                },
                {
                    "type": "shell",
                    "commands": [
                        "sed -i 's/setDesktopFileName(QStringLiteral(\"org.zealdocs.zeal\"))/setDesktopFileName(QStringLiteral(\"org.zealdocs.Zeal\"))/' src/app/main.cpp"
                    ]
                }
            ]
        }
    ]
}
